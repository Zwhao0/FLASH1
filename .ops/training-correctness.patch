+            'got {}'.format(topology))
+
+    local_state = {
+        'rank': dist.get_rank(),
+        'parameters_sha256': _model_parameters_sha256(model),
+        'scheduler_num_steps': opt_param_scheduler.num_steps,
+        'consumed_train_samples': args.consumed_train_samples,
+        'iteration': iteration,
+    }
+    gathered_states = [None] * dist.get_world_size()
+    dist.all_gather_object(gathered_states, local_state)
+
+    comparable_keys = (
+        'parameters_sha256', 'scheduler_num_steps',
+        'consumed_train_samples', 'iteration')
+    passed = all(
+        all(state[key] == gathered_states[0][key] for key in comparable_keys)
+        for state in gathered_states[1:]
+    )
+    if passed:
+        print_rank_0(
+            'GREYHOUND_VERIFY_DP PASS: all {} DP ranks agree on full model '
+            'SHA256={}, scheduler_num_steps={}, consumed_train_samples={}, '
+            'iteration={}'.format(
