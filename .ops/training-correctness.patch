+def _uses_failslow_aware_batching(args):
+    """Whether per-DP-rank microbatch redistribution is active."""
+    return (getattr(args, 'failslow_aware', False) and
+            getattr(args, 'rampup_batch_size', None) is None)
+
+
+def _iteration_batch_size(args):
+    """Return the logical global batch, independent of local DP allocation."""
+    if _uses_failslow_aware_batching(args):
+        return args.global_batch_size
+    return (args.micro_batch_size * args.data_parallel_size *
+            get_num_microbatches())
+
+
+def _model_parameters_sha256(model):
+    """Hash every model parameter without materializing the full model on CPU."""
+    digest = hashlib.sha256()
+    for chunk_index, model_chunk in enumerate(model):
+        unwrapped_chunk = unwrap_model(model_chunk)
+        for name, parameter in unwrapped_chunk.named_parameters():
+            tensor = parameter.detach().to(device='cpu').contiguous()
+            metadata = '{}:{}:{}:{}\0'.format(
+                chunk_index, name, tensor.dtype, tuple(tensor.shape))
+            digest.update(metadata.encode('utf-8'))
+            digest.update(
+                tensor.reshape(-1).view(torch.uint8).numpy().tobytes())
+    return digest.hexdigest()
+
+
